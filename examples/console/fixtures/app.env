# Optional dotenv overlay. Read after site.toml.
# The sample supplies a fixed DEMO_NAME lookup with with_environment(), so a
# process DEMO_NAME does not affect these values.
APP_demo__greeting="hello from app.env for ${DEMO_NAME}"
APP_demo__mode=dotenv

# Single-quoted values are never expanded. This one stays literal.
APP_demo__literal='${DEMO_NAME}'
